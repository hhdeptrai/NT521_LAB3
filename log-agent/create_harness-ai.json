              "preview": "//========================================================================\n//\n// Stream.h\n//\n// Copyright 1996-2003 Glyph & Cog, LLC\n//\n//========================================================================\n\n#ifndef STREAM_H\n#define STREAM_H\n\n#include <aconf.h>\n\n#ifdef USE_GCC_PRAGMAS\n#pragma interface\n#endif\n\n#include <stdio.h>\n#include \"gtypes.h\"\n#include \"Object.h\"",
