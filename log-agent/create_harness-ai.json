            "status": "completed",
            "input": {
              "content": "// Standalone reproducer: same MemStream + PDFDoc flow as harness_ai.cc,\n// but reading the input from a file argument (used only to confirm that\n// the crashes found by honggfuzz come from Xpdf itself, not the harness).\n#include <aconf.h>\n\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\n#include \"GString.h\"\n#include \"gmem.h\"\n#include \"gtypes.h\"\n#include \"GlobalParams.h\"\n#include \"Object.h\"\n#include \"Dict.h\"\n#include \"Stream.h\"\n#include \"XRef.h\"\n#include \"Catalog.h\"\n#include \"Page.h\"\n#include \"PDFDoc.h\"\n#include \"Error.h\"\n#include \"config.h\"\n\nint main(int argc, char **argv) {\n  char cfgFileName[256] = \"\";\n  FILE *f;\n  long sz;\n  char *buf;\n  Object dictObj;\n  MemStream *str;\n  PDFDoc *doc;\n\n  if (argc != 2) {\n    fprintf(stderr, \"usage: %s <pdf>\\n\", argv[0]);\n    return 2;\n  }\n  globalParams = new GlobalParams(cfgFileName);\n  globalParams->setErrQuiet(gTrue);\n\n  f = fopen(argv[1], \"rb\");\n  if (!f) { perror(\"fopen\"); return 2; }\n  fseek(f, 0, SEEK_END);\n  sz = ftell(f);\n  fseek(f, 0, SEEK_SET);\n  buf = (char *)gmalloc((int)sz);\n  if (sz > 0 && fread(buf, 1, (size_t)sz, f) != (size_t)sz) {\n    fprintf(stderr, \"short read\\n\");\n  }\n  fclose(f);\n\n  fprintf(stderr, \"[repro] parsing %s (%ld bytes)\\n\", argv[1], sz);\n  dictObj.initNull();\n  str = new MemStream(buf, 0, (Guint)sz, &dictObj);\n  doc = new PDFDoc(str);\n  fprintf(stderr, \"[repro] PDFDoc ok=%d\\n\", doc->isOk());\n  if (doc->isOk()) {\n    int n = doc->getNumPages();\n    fprintf(stderr, \"[repro] numPages=%d version=%g\\n\", n, doc->getPDFVersion());\n  }\n  delete doc;\n  gfree(buf);\n  fprintf(stderr, \"[repro] done, no crash\\n\");\n  return 0;\n}\n",
